// Resource boundary for the installed A4SMenu.dll. Upstream StartMenuDLL.rc
// remains unchanged and continues to serve the normal Open-Shell builds.

#include "../../StartMenu/StartMenuDLL/resource.h"
#include <windows.h>
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION _PRODUCT_VERSION
 PRODUCTVERSION _PRODUCT_VERSION
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "A4SMenu"
            VALUE "FileDescription", "A4SMenu popup Start menu"
            VALUE "FileVersion", _PRODUCT_VERSION_STR
            VALUE "InternalName", "A4SMenu"
            VALUE "LegalCopyright", "Copyright (C) 2009-2017 Ivo Beltchev; 2017-2018 The Open-Shell Team; A4SMenu contributors"
            VALUE "OriginalFilename", "A4SMenu.dll"
            VALUE "ProductName", "A4SMenu"
            VALUE "ProductVersion", _PRODUCT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_APPSICON            ICON "../../StartMenu/StartMenuDLL/apps.ico"
IDI_APPSICON10          ICON "../../StartMenu/StartMenuDLL/apps10.ico"
IDI_APPSICON11          ICON "../../StartMenu/StartMenuDLL/apps11.ico"

// The fixed profile consumes only this embedded Win7-style bootstrap record.
2                       SKIN "../../StartMenu/StartMenuDLL/SkinDescription7.txt"
1                       L10N "../../StartMenu/StartMenuDLL/A4SMenuL10N.txt"

IDB_ARROWS              BITMAP "../../StartMenu/StartMenuDLL/menu_arrows.bmp"
IDB_ARROWS150           BITMAP "../../StartMenu/StartMenuDLL/menu_arrows150.bmp"
IDB_SEARCH_ICONS        BITMAP "../../StartMenu/StartMenuDLL/search_icons.bmp"

STRINGTABLE
BEGIN
    IDS_APP_TITLE           "A4S Menu"
    IDS_NO_TEXT             "<No Text>"
    IDS_MENU_TITLE          "A4S Menu %d.%d.%d"
    IDS_MENU_BUSY           "Please wait for the Start menu to finish collecting information"
END

// These diagnostics protect the embedded bootstrap/parser failure path. They
// are not a skin-selection surface and contain no external-skin instructions.
STRINGTABLE
BEGIN
    IDS_SKIN_ERR_UNKNOWN    "Unknown presentation error.\r\n"
    IDS_SKIN_ERR_DISABLE    ""
    IDS_SKIN_ERR            "Presentation Error"
    IDS_SKIN_WARN           "Presentation Warning"
    IDS_SKIN_ERR_BMPRES     "Failed to load bitmap resource with ID=%d.\r\n%s"
    IDS_SKIN_ERR_BMPFILE    "Failed to load bitmap data %s.\r\n%s"
    IDS_SKIN_ERR_MASKRES    "Failed to load mask bitmap resource with ID=%d.\r\n%s"
    IDS_SKIN_ERR_MASKFILE   "Failed to load mask bitmap data %s.\r\n%s"
    IDS_SKIN_ERR_MASKSIZE   "The background bitmap %d and mask bitmap %d have different sizes.\r\n"
    IDS_SKIN_ERR_FIND_RES1  "The embedded presentation resource was not found.\r\n"
    IDS_SKIN_ERR_LOAD_RES1  "The embedded presentation resource could not be loaded.\r\n"
    IDS_SKIN_ERR_LOAD_FILE1 "The presentation data %s could not be loaded.\r\n"
END

STRINGTABLE
BEGIN
    IDS_SKIN_ERR_FIND_RES   "The embedded presentation variation %d was not found.\r\n"
    IDS_SKIN_ERR_LOAD_RES   "The embedded presentation variation %d could not be loaded.\r\n"
    IDS_SKIN_ERR_LOAD_FILE  "The presentation variation %s could not be loaded.\r\n"
    IDS_SKIN_ERR_LOAD       "Error loading %s\n%s"
    IDS_SKIN_ERR_VERSION    "The embedded presentation is not compatible with this menu version.\r\n"
    IDS_SKIN_ERR_METRO_COLOR "The embedded presentation is not compatible with this Windows version.\r\n"
    IDS_SKIN_ERR_RECBITMAP  "Presentation element %s must be a bitmap.\r\n"
END
