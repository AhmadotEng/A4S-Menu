<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import this before Common.props so its resource macros expand to the
       product version even in direct IDE/MSBuild builds. -->
  <PropertyGroup>
    <CS_VERSION>1.1.0</CS_VERSION>
    <CS_VERSION_ORIG>1.1.0.0</CS_VERSION_ORIG>
  </PropertyGroup>
</Project>
