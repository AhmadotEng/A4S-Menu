<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Keep product artifacts isolated from the upstream Open-Shell build tree. -->
    <A4SProductBuildRoot>$(MSBuildThisFileDirectory)..\..\build\A4SProduct\</A4SProductBuildRoot>
    <OutDir>$(A4SProductBuildRoot)bin\$(Platform)\</OutDir>
    <IntDir>$(A4SProductBuildRoot)obj\$(Platform)\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>A4S_PRODUCT=1;BUILD_SETUP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>A4S_PRODUCT=1;BUILD_SETUP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>
